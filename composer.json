{
    "name": "proof-holdings/sdk",
    "description": "Official PHP SDK for the proof.holdings verification API",
    "type": "library",
    "license": "MIT",
    "keywords": ["proof", "verification", "sdk", "authentication", "api", "jwt"],
    "homepage": "https://proof.holdings",
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.15.2"
    },
    "require-dev": {
        "firebase/php-jwt": "^7.0",
        "phpunit/phpunit": "^13.0"
    },
    "suggest": {
        "firebase/php-jwt": "Required for offline proof verification (^7.0 — every 6.x release carries a security advisory)"
    },
    "autoload": {
        "psr-4": {
            "ProofHoldings\\": "src/"
        },
        "classmap": [
            "src/Types.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ProofHoldings\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
